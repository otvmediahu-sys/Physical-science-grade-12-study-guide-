<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>StudyPro SA | Grade 12 Physical Sciences</title>

<style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f4f7fb;
  color:#172033;
}

button{
  font:inherit;
  cursor:pointer;
}

.hidden{
  display:none !important;
}

/* =========================
   LOGIN
========================= */

#loginView{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
  background:linear-gradient(135deg,#0b1220,#1d4ed8);
}

.login-card{
  width:100%;
  max-width:430px;
  background:white;
  padding:30px;
  border-radius:20px;
  box-shadow:0 25px 60px rgba(0,0,0,.3);
}

.logo{
  font-size:25px;
  font-weight:900;
  margin-bottom:25px;
}

.logo span{
  color:#2563eb;
}

.login-card h1{
  margin:0 0 10px;
}

.login-card p{
  color:#667085;
  line-height:1.5;
}

.field{
  margin:18px 0;
}

.field label{
  display:block;
  font-weight:bold;
  font-size:14px;
  margin-bottom:7px;
}

.field input{
  width:100%;
  padding:13px;
  border:1px solid #d5dae3;
  border-radius:9px;
  font-size:16px;
}

.field input:focus{
  outline:none;
  border-color:#2563eb;
}

.login-button{
  width:100%;
  padding:14px;
  border:0;
  border-radius:9px;
  background:#2563eb;
  color:white;
  font-weight:bold;
  font-size:16px;
}

.login-button:disabled{
  opacity:.6;
}

#error{
  color:#dc2626;
  min-height:22px;
  font-size:14px;
  margin:8px 0;
}

#status{
  color:#475569;
  min-height:22px;
  font-size:14px;
}

/* =========================
   APP
========================= */

#appView{
  min-height:100vh;
}

.topbar{
  height:65px;
  background:#0b1220;
  color:white;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 20px;
  position:sticky;
  top:0;
  z-index:20;
}

.topbar .logo{
  margin:0;
  font-size:21px;
}

.topbar-right{
  display:flex;
  align-items:center;
  gap:12px;
}

.user-email{
  font-size:13px;
  color:#dbeafe;
}

.logout{
  border:1px solid #475569;
  background:transparent;
  color:white;
  padding:9px 13px;
  border-radius:8px;
}

/* =========================
   LAYOUT
========================= */

.layout{
  display:flex;
}

.sidebar{
  width:240px;
  min-height:calc(100vh - 65px);
  background:#111827;
  padding:18px 12px;
  position:fixed;
  top:65px;
  bottom:0;
  left:0;
}

.nav-title{
  color:#94a3b8;
  font-size:11px;
  text-transform:uppercase;
  margin:10px 12px;
}

.nav-button{
  width:100%;
  text-align:left;
  border:0;
  background:transparent;
  color:#d1d5db;
  padding:13px;
  border-radius:8px;
  margin:2px 0;
}

.nav-button:hover,
.nav-button.active{
  background:#1e293b;
  color:white;
}

.main{
  margin-left:240px;
  width:calc(100% - 240px);
  padding:25px;
}

/* =========================
   HERO
========================= */

.hero{
  background:linear-gradient(135deg,#0b1220,#12356b);
  color:white;
  border-radius:20px;
  padding:35px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.hero h1{
  font-size:42px;
  margin:10px 0;
}

.hero p{
  color:#dbeafe;
  max-width:700px;
  line-height:1.6;
}

.pill{
  display:inline-block;
  background:rgba(255,255,255,.12);
  padding:7px 12px;
  border-radius:20px;
  font-size:12px;
}

.start-button{
  background:#2563eb;
  border:0;
  color:white;
  padding:13px 18px;
  border-radius:9px;
  font-weight:bold;
}

.hero-icon{
  font-size:80px;
}

/* =========================
   CARDS
========================= */

.section{
  margin-top:28px;
}

.section h2{
  margin-bottom:15px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.card{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:20px;
  box-shadow:0 5px 18px rgba(15,23,42,.05);
}

.card-icon{
  font-size:30px;
}

.card h3{
  margin-bottom:8px;
}

.card p{
  color:#667085;
  line-height:1.5;
  font-size:14px;
}

.card-button{
  width:100%;
  border:0;
  background:#2563eb;
  color:white;
  padding:11px;
  border-radius:8px;
  font-weight:bold;
}

/* =========================
   STUDY PAGE
========================= */

.study-header{
  background:white;
  padding:25px;
  border-radius:16px;
  margin-bottom:20px;
}

.study-header h1{
  margin-top:0;
}

.subject-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
}

.subject{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:25px;
}

.subject.physics{
  border-top:5px solid #2563eb;
}

.subject.chemistry{
  border-top:5px solid #16a34a;
}

.subject h2{
  margin-top:0;
}

.lesson-list{
  margin-top:18px;
}

.lesson{
  border:1px solid #e5e7eb;
  border-radius:10px;
  padding:15px;
  margin:10px 0;
  background:#f8fafc;
}

.lesson h3{
  margin:0 0 7px;
}

.lesson p{
  color:#667085;
  font-size:14px;
}

.lesson-button{
  border:0;
  background:#2563eb;
  color:white;
  padding:9px 12px;
  border-radius:7px;
  font-weight:bold;
}

/* =========================
   LESSON VIEW
========================= */

.lesson-view{
  background:white;
  border-radius:16px;
  padding:25px;
}

.back-button{
  border:1px solid #dbe3ef;
  background:#f8fafc;
  padding:10px 14px;
  border-radius:8px;
  font-weight:bold;
}

.lesson-view h1{
  font-size:34px;
}

.lesson-text{
  line-height:1.7;
  color:#334155;
}

.formula{
  background:#eff6ff;
  border-left:4px solid #2563eb;
  padding:15px;
  margin:20px 0;
  font-family:monospace;
}

.resources{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
  margin-top:25px;
}

.resource{
  padding:18px;
  border:1px solid #e5e7eb;
  border-radius:12px;
  background:#f8fafc;
}

.resource a{
  display:inline-block;
  margin-top:10px;
  background:#2563eb;
  color:white;
  padding:10px 13px;
  border-radius:8px;
  text-decoration:none;
  font-weight:bold;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px){

  .cards{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:750px){

  .topbar{
    height:60px;
  }

  .user-email{
    display:none;
  }

  .layout{
    display:block;
  }

  .sidebar{
    position:sticky;
    top:60px;
    width:100%;
    min-height:auto;
    display:flex;
    overflow-x:auto;
    padding:7px;
    z-index:10;
  }

  .nav-title{
    display:none;
  }

  .nav-button{
    width:auto;
    white-space:nowrap;
  }

  .main{
    margin-left:0;
    width:100%;
    padding:15px;
  }

  .hero{
    padding:25px;
  }

  .hero h1{
    font-size:30px;
  }

  .hero-icon{
    display:none;
  }

  .cards,
  .subject-grid,
  .resources{
    grid-template-columns:1fr;
  }

}

/* =========================
   LOADING
========================= */

#loading{
  position:fixed;
  inset:0;
  background:#0b1220;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:999;
  font-size:18px;
}

</style>
</head>

<body>

<!-- =========================
     LOADING
========================= -->

<div id="loading">
  Checking your StudyPro SA account...
</div>


<!-- =========================
     LOGIN
========================= -->

<div id="loginView" class="hidden">

  <div class="login-card">

    <div class="logo">
      StudyPro <span>SA</span>
    </div>

    <h1>Student Login</h1>

    <p>
      Sign in to access your Grade 12 Physical Sciences study programme.
    </p>

    <form id="loginForm">

      <div class="field">

        <label for="email">
          Email address
        </label>

        <input
          id="email"
          type="email"
          placeholder="student@example.com"
          autocomplete="email"
          required
        >

      </div>

      <div class="field">

        <label for="password">
          Password
        </label>

        <input
          id="password"
          type="password"
          placeholder="Your password"
          autocomplete="current-password"
          required
        >

      </div>

      <div id="error"></div>

      <div id="status"></div>

      <button
        id="loginButton"
        class="login-button"
        type="submit"
      >
        Sign in
      </button>

    </form>

  </div>

</div>


<!-- =========================
     APPLICATION
========================= -->

<div id="appView" class="hidden">

  <header class="topbar">

    <div class="logo">
      StudyPro <span>SA</span>
    </div>

    <div class="topbar-right">

      <span id="userEmail" class="user-email"></span>

      <button
        id="logoutButton"
        class="logout"
      >
        Log out
      </button>

    </div>

  </header>


  <div class="layout">

    <aside class="sidebar">

      <div class="nav-title">
        Study
      </div>

      <button
        class="nav-button active"
        data-page="start"
      >
        🚀 Start Studying
      </button>

      <button
        class="nav-button"
        data-page="physics"
      >
        ⚡ Physics
      </button>

      <button
        class="nav-button"
        data-page="chemistry"
      >
        🧪 Chemistry
      </button>

      <button
        class="nav-button"
        data-page="practice"
      >
        📝 Practice
      </button>

      <button
        class="nav-button"
        data-page="progress"
      >
        📊 Progress
      </button>

    </aside>


    <main class="main">


      <!-- =====================
           START STUDYING
      ====================== -->

      <section
        id="startPage"
        class="page"
      >

        <div class="hero">

          <div>

            <span class="pill">
              GRADE 12 • PHYSICAL SCIENCES
            </span>

            <h1>
              Start Studying 🚀
            </h1>

            <p>
              Welcome to StudyPro SA.
              Choose Physics or Chemistry below and begin your lessons.
            </p>

            <button
              class="start-button"
              data-page="physics"
            >
              Start Physics →
            </button>

          </div>

          <div class="hero-icon">
            ⚛️
          </div>

        </div>


        <div class="section">

          <h2>
            Choose your subject
          </h2>

          <div class="cards">

            <div class="card">

              <div class="card-icon">
                ⚡
              </div>

              <h3>
                Physics
              </h3>

              <p>
                Study mechanics, momentum, energy, waves,
                electricity, electrostatics and more.
              </p>

              <button
                class="card-button"
                data-page="physics"
              >
                Open Physics
              </button>

            </div>


            <div class="card">

              <div class="card-icon">
                🧪
              </div>

              <h3>
                Chemistry
              </h3>

              <p>
                Study chemical reactions, equilibrium,
                acids and bases, electrochemistry and organic chemistry.
              </p>

              <button
                class="card-button"
                data-page="chemistry"
              >
                Open Chemistry
              </button>

            </div>


            <div class="card">

              <div class="card-icon">
                📝
              </div>

              <h3>
                Practice
              </h3>

              <p>
                Test your understanding with Grade 12
                Physical Sciences questions.
              </p>

              <button
                class="card-button"
                data-page="practice"
              >
                Open Practice
              </button>

            </div>


            <div class="card">

              <div class="card-icon">
                📊
              </div>

              <h3>
                Progress
              </h3>

              <p>
                Track the lessons you complete.
              </p>

              <button
                class="card-button"
                data-page="progress"
              >
                View Progress
              </button>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================
           PHYSICS
      ====================== -->

      <section
        id="physicsPage"
        class="page hidden"
      >

        <div class="study-header">

          <h1>
            ⚡ Physics
          </h1>

          <p>
            Grade 12 Physical Sciences — Physics lessons.
          </p>

        </div>


        <div class="subject-grid">

          <div class="subject physics">

            <h2>
              Mechanics
            </h2>

            <div class="lesson-list">

              <div class="lesson">

                <h3>
                  1. Momentum and Impulse
                </h3>

                <p>
                  Momentum, impulse and conservation of momentum.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="momentum"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  2. Vertical Projectile Motion
                </h3>

                <p>
                  Motion of objects projected vertically upwards and downwards.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="projectile"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  3. Work, Energy and Power
                </h3>

                <p>
                  Work done, kinetic energy, potential energy and power.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="energy"
                >
                  Open Lesson
                </button>

              </div>

            </div>

          </div>


          <div class="subject physics">

            <h2>
              Electricity & Waves
            </h2>

            <div class="lesson-list">

              <div class="lesson">

                <h3>
                  4. Electric Circuits
                </h3>

                <p>
                  Current, potential difference, resistance and Ohm's law.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="circuits"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  5. Electrostatics
                </h3>

                <p>
                  Electric charge, electric fields and Coulomb's law.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="electrostatics"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  6. Doppler Effect
                </h3>

                <p>
                  Understanding the change in observed frequency.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="doppler"
                >
                  Open Lesson
                </button>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================
           CHEMISTRY
      ====================== -->

      <section
        id="chemistryPage"
        class="page hidden"
      >

        <div class="study-header">

          <h1>
            🧪 Chemistry
          </h1>

          <p>
            Grade 12 Physical Sciences — Chemistry lessons.
          </p>

        </div>


        <div class="subject-grid">

          <div class="subject chemistry">

            <h2>
              Chemical Reactions
            </h2>

            <div class="lesson-list">

              <div class="lesson">

                <h3>
                  1. Stoichiometry
                </h3>

                <p>
                  Mole calculations and quantitative relationships.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="stoichiometry"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  2. Chemical Equilibrium
                </h3>

                <p>
                  Dynamic equilibrium and equilibrium constants.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="equilibrium"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  3. Acids and Bases
                </h3>

                <p>
                  pH, strong acids, weak acids and neutralisation.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="acids"
                >
                  Open Lesson
                </button>

              </div>

            </div>

          </div>


          <div class="subject chemistry">

            <h2>
              Electrochemistry & Organic Chemistry
            </h2>

            <div class="lesson-list">

              <div class="lesson">

                <h3>
                  4. Electrochemical Cells
                </h3>

                <p>
                  Galvanic cells, electrolytic cells and redox reactions.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="electrochemistry"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  5. Organic Chemistry
                </h3>

                <p>
                  Organic compounds and functional groups.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="organic"
                >
                  Open Lesson
                </button>

              </div>


              <div class="lesson">

                <h3>
                  6. Reaction Rates
                </h3>

                <p>
                  Factors affecting the rate of chemical reactions.
                </p>

                <button
                  class="lesson-button"
                  data-lesson="rates"
                >
                  Open Lesson
                </button>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =====================
           LESSON
      ====================== -->

      <section
        id="lessonPage"
        class="page hidden"
      >

        <div class="lesson-view">

          <button
            id="backToLessons"
            class="back-button"
          >
            ← Back to lessons
          </button>

          <div id="lessonContent"></div>

        </div>

      </section>


      <!-- =====================
           PRACTICE
      ====================== -->

      <section
        id="practicePage"
        class="page hidden"
      >

        <div class="study-header">

          <h1>
            📝 Practice
          </h1>

          <p>
            Quick Grade 12 Physical Sciences practice.
            
